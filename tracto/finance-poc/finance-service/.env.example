# Copy to .env (same folder as finance-service.exe, or the folder you start it from).
# A real environment variable overrides the same name in this file.

# Port the service listens on (default 5095)
FINANCE_SERVICE_PORT=5095

# The hand-over folders (claims, bills, payments, exceptions). Relative paths are from the folder
# the service is started in. Default ../poc-data
FINANCE_DATA_DIR=../poc-data

# Reference data: expense categories with account codes, payees with bank details. Default ../seed
FINANCE_SEED_DIR=../seed

# Orchestrator whose run log receives a line per item (default http://127.0.0.1:5080; "off" = console only)
FINANCE_ORCHESTRATOR_URL=http://127.0.0.1:5080

# Script ids of the two main jobs, used to find the run that called the service
FINANCE_A1_SCRIPT=finance-a1-claims-to-bills
FINANCE_A2_SCRIPT=finance-a2-payment-file

# Printed on the bills and in the payment file header
FINANCE_ORG_NAME=Demo Organisation
FINANCE_ORG_ACCOUNT=DEMO-ORG-0001
