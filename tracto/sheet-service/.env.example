# Copy to .env (same folder as sheet-service.exe, or the folder you start it from) and fill in what you use.
# A real environment variable overrides the same name in this file.

# Port the service listens on (default 5090)
SHEET_SERVICE_PORT=5090

# Google Sheets: path to the service-account key file (JSON), or a ready access token
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ACCESS_TOKEN=

# Microsoft (OneDrive / SharePoint): the app registration (Application ID and Directory ID).
# Sign in once with: sheet-service login
MS_TENANT_ID=
MS_CLIENT_ID=
# Optional: permissions to request (default: Files.ReadWrite.All offline_access)
MS_SCOPES=
# Optional: a ready access token, used instead of the saved sign-in
MS_ACCESS_TOKEN=

# SQLite file that holds the saved Microsoft sign-in (default: sheet-service.db in the working directory)
SHEET_SERVICE_DB=

# Batches that run a child job for each row (POST /process/start)
# Orchestrator the child jobs are queued on (default http://127.0.0.1:5080)
SHEET_SERVICE_ORCHESTRATOR_URL=
# SQLite file that keeps batch progress (default: sheet-batches.db in the working directory)
SHEET_SERVICE_BATCH_DB=
