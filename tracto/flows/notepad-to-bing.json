{
  "name": "notepad-to-bing",
  "description": "Flow 2. Open a Notepad text file, copy its text, search Bing for it in a browser and read the first result.",
  "params": {
    "notePath": "C:\\Users\\TNT\\Downloads\\rpa-scripts\\search-text.txt",
    "noteName": "search-text.txt"
  },
  "scripts": [
    {
      "id": "notepad-read-text",
      "name": "Notepad Read Text",
      "version": "1.0.0",
      "targetRuntime": "desktop",
      "steps": [
        {
          "stepNumber": 1,
          "action": "app.launch",
          "description": "Open the text file in Notepad",
          "parameters": {
            "executable": "notepad.exe",
            "args": "${param.notePath}"
          }
        },
        {
          "stepNumber": 2,
          "action": "delay",
          "description": "Wait for the Notepad window",
          "parameters": {
            "ms": "2000"
          }
        },
        {
          "stepNumber": 3,
          "action": "key",
          "description": "Select all the text in that Notepad window",
          "parameters": {
            "key": "Ctrl+A",
            "window": "${param.noteName} - Notepad"
          }
        },
        {
          "stepNumber": 4,
          "action": "key",
          "description": "Copy the selection",
          "parameters": {
            "key": "Ctrl+C",
            "window": "${param.noteName} - Notepad"
          }
        },
        {
          "stepNumber": 5,
          "action": "delay",
          "description": "Let the clipboard settle",
          "parameters": {
            "ms": "500"
          }
        },
        {
          "stepNumber": 6,
          "action": "clipboard.get",
          "description": "Read the copied text (outputs note.text and note.firstLine)",
          "parameters": {
            "storeAs": "note"
          }
        },
        {
          "stepNumber": 7,
          "action": "key",
          "description": "Close the unchanged file without a prompt",
          "parameters": {
            "key": "Alt+F4",
            "window": "${param.noteName} - Notepad"
          }
        }
      ]
    },
    {
      "id": "bing-search-from-note",
      "name": "Bing Search From Note",
      "version": "1.0.0",
      "targetRuntime": "browser",
      "steps": [
        {
          "stepNumber": 1,
          "action": "navigate",
          "description": "Open Bing",
          "parameters": {
            "url": "https://www.bing.com/"
          }
        },
        {
          "stepNumber": 2,
          "action": "fill",
          "description": "Type the first line read from the Notepad file",
          "parameters": {
            "css": "#sb_form_q",
            "value": "${param.note.firstLine}"
          }
        },
        {
          "stepNumber": 3,
          "action": "delay",
          "description": "Let the page attach its handlers before Enter",
          "parameters": {
            "ms": "500"
          }
        },
        {
          "stepNumber": 4,
          "action": "press",
          "description": "Submit the search",
          "parameters": {
            "css": "#sb_form_q",
            "key": "Enter"
          }
        },
        {
          "stepNumber": 5,
          "action": "wait",
          "description": "Wait for the results list",
          "parameters": {
            "css": "#b_results",
            "timeoutMs": "15000"
          }
        },
        {
          "stepNumber": 6,
          "action": "getText",
          "description": "Read the first result title (output: first)",
          "parameters": {
            "css": "#b_results li.b_algo h2 >> nth=0",
            "storeAs": "first"
          }
        }
      ]
    }
  ]
}