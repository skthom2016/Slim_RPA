{
  "name": "bing-to-notepad",
  "description": "Flow 1. Search Bing in a browser, take the top result titles and write them into a Notepad file.",
  "params": {
    "query": "Playwright for .NET",
    "outputPath": "C:\\Users\\TNT\\Downloads\\rpa-scripts\\bing-results.txt",
    "outputName": "bing-results.txt"
  },
  "scripts": [
    {
      "id": "bing-top-results",
      "name": "Bing Top Results",
      "version": "1.0.0",
      "targetRuntime": "browser",
      "steps": [
        {
          "stepNumber": 1,
          "action": "navigate",
          "description": "Open Bing",
          "parameters": {
            "url": "https://www.bing.com/"
          }
        },
        {
          "stepNumber": 2,
          "action": "fill",
          "description": "Type the search text supplied by the flow",
          "parameters": {
            "css": "#sb_form_q",
            "value": "${param.query}"
          }
        },
        {
          "stepNumber": 3,
          "action": "delay",
          "description": "Let the page attach its handlers before Enter",
          "parameters": {
            "ms": "500"
          }
        },
        {
          "stepNumber": 4,
          "action": "press",
          "description": "Submit the search",
          "parameters": {
            "css": "#sb_form_q",
            "key": "Enter"
          }
        },
        {
          "stepNumber": 5,
          "action": "wait",
          "description": "Wait for the results list",
          "parameters": {
            "css": "#b_results",
            "timeoutMs": "15000"
          }
        },
        {
          "stepNumber": 6,
          "action": "getTexts",
          "description": "Read the first 10 result titles as one text block (output: results)",
          "parameters": {
            "css": "#b_results li.b_algo h2",
            "limit": "10",
            "storeAs": "results"
          }
        }
      ]
    },
    {
      "id": "notepad-from-param",
      "name": "Notepad From Param",
      "version": "1.0.0",
      "targetRuntime": "desktop",
      "steps": [
        {
          "stepNumber": 1,
          "action": "app.launch",
          "description": "Open Notepad",
          "parameters": {
            "executable": "notepad.exe"
          }
        },
        {
          "stepNumber": 2,
          "action": "delay",
          "description": "Wait for the Notepad window",
          "parameters": {
            "ms": "1500"
          }
        },
        {
          "stepNumber": 3,
          "action": "notepad.type",
          "description": "Paste the results handed over by the previous flow step",
          "parameters": {
            "text": "BING RESULTS for ${param.query} (${now.local})\r\n${param.results}\r\n",
            "windowTitle": "Untitled - Notepad"
          }
        },
        {
          "stepNumber": 4,
          "action": "delay",
          "description": "Let Notepad update its title",
          "parameters": {
            "ms": "1000"
          }
        },
        {
          "stepNumber": 5,
          "action": "file.saveAs",
          "description": "Save the file (the window is titled after the first line)",
          "parameters": {
            "filePath": "${param.outputPath}",
            "windowTitle": "BING RESULTS"
          }
        },
        {
          "stepNumber": 6,
          "action": "delay",
          "description": "Wait for the save",
          "parameters": {
            "ms": "1000"
          }
        },
        {
          "stepNumber": 7,
          "action": "key",
          "description": "Close the saved document",
          "parameters": {
            "key": "Alt+F4",
            "window": "${param.outputName} - Notepad"
          }
        }
      ]
    }
  ]
}