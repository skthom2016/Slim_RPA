# Copy to .env in this folder (or beside the built executable) and fill in what you need.
# A real environment variable always overrides the same name here.
# This file holds passwords: it is gitignored, and it must stay that way.

# Secrets a script reads as ${secret:NAME}. The variable is TRACTO_SECRET_ plus the name
# in capitals, so ${secret:ACME_PASSWORD} is read from TRACTO_SECRET_ACME_PASSWORD.
# Values are never logged and never returned in a run's results.
TRACTO_SECRET_ACME_PASSWORD=

# Optional host settings; these have working defaults in appsettings.json.
# Host__OrchestratorUrl=http://localhost:5080
# Host__WorkerId=browser-worker-1
# Host__Mode=headed
# Host__Profile=
