# Copy to .env next to the executable (or the folder you run it from). Real environment variables win
# over this file. .env is ignored by git: never commit a real password.

# PostgreSQL database (required). The service creates its own schema and tables on start-up.
DATABASE_URL=postgres://tracto:CHANGE-ME@localhost:5432/tracto?sslmode=disable

# Schema for the orchestrator's tables (default: orchestrator)
ORCHESTRATOR_SCHEMA=

# HTTP port (default 5080) and mode: isolated binds 127.0.0.1, connected binds all addresses
ORCHESTRATOR_PORT=5080
TRACTO_MODE=isolated

# Leave the signing key empty for development (tokens are not verified). Set it for any shared machine.
ORCHESTRATOR_JWT_SECRET=

# Only these addresses may call /admin (a CIDR, for example 10.0.0.0/8). Empty: no restriction.
ORCHESTRATOR_ADMIN_CIDR=

# Callback signing keys: keyId:secret,keyId2:secret2
ORCHESTRATOR_HMAC_KEYS=

# Run the database tests too: a server the tests may create and drop schemas on (default: DATABASE_URL)
TEST_DATABASE_URL=
