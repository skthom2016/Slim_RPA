# Copy to .env next to the executable (or the folder you run it from). Real environment variables win
# over this file. .env is ignored by git: never commit a real password.

# PostgreSQL database (required). The service creates its own schema and tables on start-up.
DATABASE_URL=postgres://tracto:CHANGE-ME@localhost:5432/tracto?sslmode=disable

# Schema for the orchestrator's tables (default: orchestrator)
ORCHESTRATOR_SCHEMA=

# HTTP port (default 5080) and mode: isolated binds 127.0.0.1, connected binds all addresses
ORCHESTRATOR_PORT=5080
TRACTO_MODE=isolated

# Leave the signing key empty for development (tokens are not verified). Set it for any shared machine.
ORCHESTRATOR_JWT_SECRET=

# Only these addresses may call /admin (a CIDR, for example 10.0.0.0/8). Empty: no restriction.
ORCHESTRATOR_ADMIN_CIDR=

# Callback signing keys: keyId:secret,keyId2:secret2
ORCHESTRATOR_HMAC_KEYS=

# Credential store: the key that seals passwords and one-time-code keys in the database (32 random
# bytes, base64). Without it the orchestrator runs jobs but the Credentials page is locked.
# Keep it out of the database and out of version control; back it up apart from the database:
# losing it means every password has to be entered again. Make one with:
#   PowerShell:   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS:  openssl rand -base64 32
CREDENTIAL_MASTER_KEY=
# Which key sealed a value, so the key can be replaced later (default 1). To replace the key: put
# the old one in CREDENTIAL_MASTER_KEY_OLD (with its id in CREDENTIAL_MASTER_KEY_OLD_ID, default 1),
# the new one in CREDENTIAL_MASTER_KEY with a new CREDENTIAL_MASTER_KEY_ID, run "orchestrator rekey"
# (go run . rekey), then remove CREDENTIAL_MASTER_KEY_OLD.
CREDENTIAL_MASTER_KEY_ID=
CREDENTIAL_MASTER_KEY_OLD=
CREDENTIAL_MASTER_KEY_OLD_ID=

# Run the database tests too: a server the tests may create and drop schemas on (default: DATABASE_URL)
TEST_DATABASE_URL=
