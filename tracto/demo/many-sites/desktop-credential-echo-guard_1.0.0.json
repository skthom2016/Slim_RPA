{
  "id": "desktop-credential-echo-guard",
  "name": "Desktop Credential Echo Guard",
  "version": "1.0.0",
  "params": { "site": "site-a", "target": "http://localhost:8781/reflect" },
  "segments": [
    {
      "name": "Send the credential",
      "runtime": "desktop",
      "steps": [
        { "stepNumber": 1, "action": "http.post",
          "description": "The target sends the password straight back; storing that reply as an output must be refused",
          "parameters": {
            "url": "${param.target}",
            "body": "pw=${credential:${param.site}.password}",
            "contentType": "text/plain",
            "storeAs": "reply"
          } }
      ]
    }
  ]
}