{
  "id": "desktop-credential-check",
  "name": "Desktop Credential Check",
  "version": "1.0.0",
  "params": { "site": "site-a", "target": "http://localhost:8781/echo" },
  "segments": [
    {
      "name": "Send the credential",
      "runtime": "desktop",
      "steps": [
        { "stepNumber": 1, "action": "http.post",
          "description": "Send this site's stored user id and password to the target, as a desktop step signing in to an API would",
          "parameters": {
            "url": "${param.target}",
            "body": "user=${credential:${param.site}.username}&pw=${credential:${param.site}.password}",
            "contentType": "text/plain",
            "storeAs": "reply"
          } }
      ]
    }
  ]
}