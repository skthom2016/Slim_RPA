{
  "id": "acme-invoice-excel",
  "name": "ACME Invoice From Excel",
  "version": "1.0.0",
  "params": {
    "excelPath": "H:/Neelitech/Slim_RPA/tracto/demo/acme-invoices.xlsx.xlsx",
    "sheetName": "Invoices",
    "rowNumber": "2",
    "idColumn": "Id"
  },
  "segments": [
    {
      "name": "Read the invoice number from Excel",
      "runtime": "desktop",
      "steps": [
        {
          "stepNumber": 1,
          "action": "http.post",
          "description": "Read one cell: the invoice number on the chosen row",
          "parameters": {
            "url": "http://localhost:5090/cell",
            "body": "{\"source\":{\"path\":\"${param.excelPath}\",\"sheet\":\"${param.sheetName}\"},\"row\":${param.rowNumber},\"column\":\"${param.idColumn}\",\"required\":true}",
            "storeAs": "invoice"
          }
        }
      ]
    },
    {
      "name": "Search the invoice on ACME",
      "runtime": "browser",
      "profile": "default",
      "steps": [
        { "stepNumber": 1, "action": "navigate", "description": "Open the invoice search page",
          "parameters": { "url": "https://acme-test.uipath.com/invoices/search" } },
        { "stepNumber": 2, "action": "wait", "description": "Wait for the search box (not there means the profile is signed out)",
          "parameters": { "css": "#invoiceNumber", "timeoutMs": "15000" } },
        { "stepNumber": 3, "action": "fill", "description": "Type the invoice number from Excel",
          "parameters": { "css": "#invoiceNumber", "value": "${param.invoice.value}" } },
        { "stepNumber": 4, "action": "click", "description": "Click Search",
          "parameters": { "role": "button", "name": "Search" } },
        { "stepNumber": 5, "action": "wait", "description": "Wait for the result row",
          "parameters": { "css": "table.table td:nth-child(3)", "timeoutMs": "15000" } },
        { "stepNumber": 6, "action": "getText", "description": "Read Invoice Item",
          "parameters": { "css": "table.table td:nth-child(3)", "storeAs": "invItem" } },
        { "stepNumber": 7, "action": "getText", "description": "Read Total",
          "parameters": { "css": "table.table td:nth-child(4)", "storeAs": "invTotal" } },
        { "stepNumber": 8, "action": "getText", "description": "Read Date",
          "parameters": { "css": "table.table td:nth-child(5)", "storeAs": "invDate" } }
      ]
    },
    {
      "name": "Write the three values back to Excel",
      "runtime": "desktop",
      "steps": [
        {
          "stepNumber": 1,
          "action": "http.post",
          "description": "Fill InvoiceItem, Total and Date on the same row",
          "parameters": {
            "url": "http://localhost:5090/update",
            "body": "{\"source\":{\"path\":\"${param.excelPath}\",\"sheet\":\"${param.sheetName}\"},\"rows\":[{\"row\":${param.rowNumber},\"values\":{\"InvoiceItem\":\"${param.invItem.value}\",\"Total\":\"${param.invTotal.value}\",\"Date\":\"${param.invDate.value}\"}}]}",
            "storeAs": "written"
          }
        }
      ]
    }
  ]
}
