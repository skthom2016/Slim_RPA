{
  "id": "acme-login-child-fetch-invoice",
  "name": "ACME Child: Sign In And Fetch One Invoice",
  "version": "1.0.0",
  "params": {
    "invoiceId": "349236"
  },
  "segments": [
    {
      "name": "Sign in with the stored ACME credential, then search one invoice",
      "runtime": "browser",
      "steps": [
        { "stepNumber": 1, "action": "navigate", "description": "Open the ACME login page in an empty browser",
          "parameters": { "url": "https://acme-test.uipath.com/login" } },
        { "stepNumber": 2, "action": "fill", "description": "Enter the e-mail of the stored credential",
          "parameters": { "css": "#email", "value": "${credential:acme-login.username}" } },
        { "stepNumber": 3, "action": "fill", "description": "Enter the password of the stored credential",
          "parameters": { "css": "#password", "value": "${credential:acme-login.password}" } },
        { "stepNumber": 4, "action": "click", "description": "Click Login",
          "parameters": { "role": "button", "name": "Login" } },
        { "stepNumber": 5, "action": "delay", "description": "Let the sign-in finish before leaving the page",
          "parameters": { "ms": "3000" } },
        { "stepNumber": 6, "action": "navigate", "description": "Only after signing in, open the invoice search page",
          "parameters": { "url": "https://acme-test.uipath.com/invoices/search" } },
        { "stepNumber": 7, "action": "wait", "description": "Wait for the search box (not there means the sign-in failed and the site sent us back to the login page)",
          "parameters": { "css": "#invoiceNumber", "timeoutMs": "15000" } },
        { "stepNumber": 8, "action": "fill", "description": "Type the invoice number the batch passed in",
          "parameters": { "css": "#invoiceNumber", "value": "${param.invoiceId}" } },
        { "stepNumber": 9, "action": "click", "description": "Click Search",
          "parameters": { "role": "button", "name": "Search" } },
        { "stepNumber": 10, "action": "wait", "description": "Wait for the result row (not there means no such invoice)",
          "parameters": { "css": "table.table td:nth-child(3)", "timeoutMs": "15000" } },
        { "stepNumber": 11, "action": "getText", "description": "Read Invoice Item",
          "parameters": { "css": "table.table td:nth-child(3)", "storeAs": "invItem" } },
        { "stepNumber": 12, "action": "getText", "description": "Read Total",
          "parameters": { "css": "table.table td:nth-child(4)", "storeAs": "invTotal" } },
        { "stepNumber": 13, "action": "getText", "description": "Read Date",
          "parameters": { "css": "table.table td:nth-child(5)", "storeAs": "invDate" } }
      ]
    }
  ]
}
