<UserControl x:Class="Tracto.Designer.App.Views.PublicationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="240" d:DesignWidth="800">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Publish Script" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PublisherName}" Style="{StaticResource CaptionText}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="Publishing..." Style="{StaticResource CaptionText}" Margin="10,0,0,0"
                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Output directory" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                    Command="{Binding PublishCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Publish" VerticalAlignment="Center"
                               Foreground="{StaticResource TextOnAccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Padding="11,9"
                BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding LastResult.Success, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="Published — ID:"/><Run Text=" "/><Run Text="{Binding LastResult.PublicationId}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding LastResult.Success, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="FAILED:"/><Run Text=" "/><Run Text="{Binding LastResult.Message}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
