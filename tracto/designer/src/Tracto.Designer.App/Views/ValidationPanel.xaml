<UserControl x:Class="Tracto.Designer.App.Views.ValidationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="240" d:DesignWidth="800">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Validation" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>

                <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                        Background="{StaticResource SuccessSubtleBrush}" BorderBrush="{StaticResource SuccessSubtleBrush}"
                        Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Valid" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                        Background="{StaticResource DangerSubtleBrush}" BorderBrush="{StaticResource DangerSubtleBrush}"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Invalid" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                    Content="Validate" Command="{Binding ValidateCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Result.Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="10,7" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="19" Height="19" CornerRadius="4"
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLetterConverter}}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding RuleId}" Width="74" Margin="10,0,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="{Binding StepNumber, StringFormat='(step {0})'}"
                                           Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
