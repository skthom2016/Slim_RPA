<UserControl x:Class="Tracto.Designer.App.Views.AuditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audit="clr-namespace:Tracto.Designer.Core.Audit;assembly=Tracto.Designer.Core">
    <UserControl.Resources>
        <Style x:Key="OutcomeStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static audit:AuditOutcome.Success}">
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static audit:AuditOutcome.Failure}">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static audit:AuditOutcome.Skipped}">
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="4">
            <TextBlock Text="Audit Log" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="4,0,0,0"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding CategoryFilter, Mode=TwoWay}"
                      Width="140">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Audit entry grid -->
        <DataGrid ItemsSource="{Binding DisplayedEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Width="80"
                    Binding="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                <DataGridTextColumn Header="Category" Width="100"
                    Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Action" Width="160"
                    Binding="{Binding Action}"/>
                <DataGridTemplateColumn Header="Outcome" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource OutcomeStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Details" Width="*"
                    Binding="{Binding Details}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
