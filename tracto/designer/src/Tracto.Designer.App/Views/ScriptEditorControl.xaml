<UserControl x:Class="Tracto.Designer.App.Views.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="306" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left: the script, its parameters and its segments ═══════════
             Scrolls, so the segment list and its commands stay reachable however
             short the editor pane is. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,14,8,14">
          <StackPanel>

            <!-- Name and version -->
            <StackPanel>
                <TextBlock Text="Script" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                <TextBox Text="{Binding Script.Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Version" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                <TextBox Text="{Binding Script.Version, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left" Width="110"/>
            </StackPanel>

            <!-- Parameters: only meaningful once the script has segments -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsSegmented, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Parameters" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ParamsText, UpdateSourceTrigger=LostFocus}"
                         Height="62" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         ToolTip="Default values, one name=value per line. Steps read them as ${param.name}. A job can override them."/>
                <TextBlock Text="one name=value per line" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Segment list header with its add and reorder commands -->
            <Grid Margin="0,16,0,6"
                  Visibility="{Binding IsSegmented, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Segments" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE70E;"
                            Command="{Binding MoveSegmentUpCommand}" ToolTip="Move the selected segment up"/>
                    <Button Style="{StaticResource IconButton}" Tag="&#xE70D;"
                            Command="{Binding MoveSegmentDownCommand}" ToolTip="Move the selected segment down"/>
                    <Button Style="{StaticResource DangerIconButton}" Tag="&#xE74D;"
                            Command="{Binding DeleteSegmentCommand}" ToolTip="Delete the selected segment"/>
                </StackPanel>
            </Grid>

            <!-- Shown until the script has segments, so the empty panel explains itself. -->
            <TextBlock Margin="0,14,0,0"
                       Text="No segments yet. Add one to choose the runtime it records and runs on."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextTertiaryBrush}">
                <TextBlock.Visibility>
                    <Binding Path="IsSegmented" Converter="{StaticResource InverseBoolToVisibilityConverter}"/>
                </TextBlock.Visibility>
            </TextBlock>

            <ListBox ItemsSource="{Binding Script.Segments}"
                     SelectedItem="{Binding SelectedSegment}"
                     MinHeight="108" MaxHeight="260"
                     Visibility="{Binding IsSegmented, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border Style="{StaticResource Pill}" Padding="6,1"
                                        Background="{StaticResource AccentSubtleBrush}"
                                        BorderBrush="{StaticResource AccentSubtleBrush}">
                                    <TextBlock Text="{Binding Runtime}" Style="{StaticResource CaptionText}"
                                               FontSize="11" Foreground="{StaticResource AccentHoverBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Mode}" Style="{StaticResource CaptionText}"
                                           FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add Segment stays reachable even before a script exists -->
            <StackPanel Margin="0,10,0,0">
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"
                        Command="{Binding AddSegmentCommand}"
                        ToolTip="Add a segment after the selected one. The first segment takes the script's existing steps.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Add Segment" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnAccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                        Content="Make Single" Command="{Binding MergeToSingleCommand}"
                        ToolTip="Turn a script with one segment back into a single-runtime script."/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderSoftBrush}" Margin="0,14"/>

        <!-- ══ Right: the selected segment and its steps ═══════════════════ -->
        <!-- Scrolls when the segment settings leave too little room, so the step list and the
             step details are always reachable. When there is room the Grid fills the pane and
             the step list takes whatever the other rows leave. -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="440"/>
            </Grid.RowDefinitions>

            <!-- Segment name and runtime -->
            <StackPanel Grid.Row="0"
                        Visibility="{Binding HasSelectedSegment, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Selected segment" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Width="260">
                        <TextBlock Text="Segment name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SelectedSegment.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="12,0,0,0">
                        <TextBlock Text="Runtime" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding RuntimeOptions}"
                                  SelectedItem="{Binding SelectedSegment.Runtime}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Browser segments: how it runs later, and how it is recorded now -->
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    Visibility="{Binding SelectedSegment.IsBrowser, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Browser segment" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="7,0,0,0"/>
                    </StackPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Width="140" Margin="0,0,12,8">
                            <TextBlock Text="Browser mode" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding SelectedSegment.Mode}"
                                      ToolTip="How this segment runs later. Leave empty to use the browser host's own BROWSER_MODE setting."/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,8">
                            <TextBlock Text="Record in" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DataContext.BrowserAdapter.BrowserTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.BrowserAdapter.SelectedBrowser, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,12,8">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DataContext.BrowserAdapter.DebugPort, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                        <StackPanel Width="210" Margin="0,0,12,8">
                            <TextBlock Text="Browser session" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding BrowserSessionOptions}"
                                      SelectedItem="{Binding SelectedSegment.BrowserSession}"
                                      ToolTip="Whether this segment needs a signed-in browser, or an empty one."/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="{Binding SelectedSegment.BrowserSessionSummary}"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Reminder of where the one shared sign-in is done. -->
                    <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="10,7" Margin="0,0,0,8"
                            Visibility="{Binding SelectedSegment.UseSignedInProfile, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Top"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="8,0,0,0"
                                       Text="There is one signed-in browser per machine. If it is already signed in, this segment uses it. To sign in, or to sign in as someone else, use Sign in on the toolbar above."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Start URL" Style="{StaticResource FieldLabel}" Margin="0,2,0,3"/>
                    <TextBox Text="{Binding DataContext.BrowserAdapter.StartUrl, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Where recording this segment begins."/>
                    <TextBlock Text="{Binding DataContext.BrowserAdapter.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CaptionText}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding DataContext.ProfileSignIn.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource AccentHoverBrush}"
                               Visibility="{Binding DataContext.ProfileSignIn.Status, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TextToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Steps header with its add, reorder and delete commands -->
            <Grid Grid.Row="2" Margin="0,18,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Steps" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSegment.Title}" Style="{StaticResource CaptionText}"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsSegmented, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE710;"
                            Command="{Binding AddStepCommand}" ToolTip="Add a step"/>
                    <Button Style="{StaticResource IconButton}" Tag="&#xE70E;"
                            Command="{Binding MoveUpCommand}" ToolTip="Move the selected step up"/>
                    <Button Style="{StaticResource IconButton}" Tag="&#xE70D;"
                            Command="{Binding MoveDownCommand}" ToolTip="Move the selected step down"/>
                    <Button Style="{StaticResource DangerIconButton}" Tag="&#xE74D;"
                            Command="{Binding DeleteStepCommand}" ToolTip="Delete the selected step"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding ActiveSteps}" SelectedItem="{Binding SelectedStep}"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource SubtleHoverBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StepNumber}" Style="{StaticResource CaptionText}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="4,0"/>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="6,1" Margin="6,0,0,0"
                                        Background="{StaticResource SubtleHoverBrush}"
                                        BorderBrush="{StaticResource SubtleHoverBrush}">
                                    <TextBlock Text="{Binding Action}" Style="{StaticResource CaptionText}"
                                               FontSize="11" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                              VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

                <!-- ══ The selected step: what it does, and the data it passes on ══ -->
                <Border Grid.Row="2" Padding="12" MaxHeight="268"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}"
                        Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="286"/>
                        </Grid.ColumnDefinitions>

                        <!-- Action, outputs and parameters -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Step" Style="{StaticResource SectionTitle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel Width="190">
                                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding ActionOptions}"
                                                  AutomationProperties.AutomationId="StepAction"
                                                  AutomationProperties.Name="Step action"
                                                  Text="{Binding SelectedStep.Action, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="What this step does. The list holds the actions this segment's runtime knows; another name can be typed."/>
                                    </StackPanel>
                                    <StackPanel Width="190" Margin="12,0,0,0">
                                        <TextBlock Text="Store result as" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding StoreAs, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.AutomationId="StepStoreAs"
                                                 AutomationProperties.Name="Store result as"
                                                 ToolTip="Name this step's outputs so later steps, and later segments, can read them."/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding StoreAsHint}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="Parameters" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE710;"
                                                Command="{Binding AddParameterCommand}" ToolTip="Add a parameter"/>
                                        <Button Style="{StaticResource DangerIconButton}" Tag="&#xE74D;"
                                                Command="{Binding DeleteParameterCommand}" ToolTip="Delete the selected parameter"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox ItemsSource="{Binding StepParameters}" SelectedItem="{Binding SelectedParameter}"
                                         MinHeight="56" MaxHeight="118" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.AutomationId="ParameterName"
                                                         AutomationProperties.Name="Parameter name"
                                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Background="Transparent" BorderThickness="0" Padding="2,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.AutomationId="ParameterValue"
                                                         AutomationProperties.Name="Parameter value"
                                                         Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Background="Transparent" BorderThickness="0" Padding="2,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- What this step may read, including anything an earlier segment published -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Data you can use here" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,6"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="Select a parameter, then click a value to insert it."/>

                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="Nothing before this step publishes any data. Give an earlier step a name under Store result as."
                                       Visibility="{Binding HasAvailableData, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <ListBox ItemsSource="{Binding AvailableData}" MaxHeight="190"
                                     HorizontalContentAlignment="Stretch"
                                     Visibility="{Binding HasAvailableData, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.InsertReferenceCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="8,5" Margin="0,0,0,3"
                                                ToolTip="{Binding ProducedBy}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reference}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OriginLabel}" Style="{StaticResource CaptionText}"
                                                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
