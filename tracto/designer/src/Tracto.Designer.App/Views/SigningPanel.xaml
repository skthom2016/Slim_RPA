<UserControl x:Class="Tracto.Designer.App.Views.SigningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="240" d:DesignWidth="800">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Script Signing" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SignerName}" Style="{StaticResource CaptionText}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>

                <Border Margin="10,0,0,0"
                        Background="{StaticResource SuccessSubtleBrush}" BorderBrush="{StaticResource SuccessSubtleBrush}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Signed" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButton}" Content="Sign" Command="{Binding SignCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Verify" Margin="6,0,0,0"
                        Command="{Binding VerifyCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Signature detail, shown once the script carries a signature -->
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,8"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="{StaticResource ControlRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSigned}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Style="{StaticResource CaptionText}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Algorithm: {0}">
                            <Binding Path="CurrentSignature.Algorithm"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Timestamp: {0}">
                            <Binding Path="CurrentSignature.Timestamp"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Digest: {0}...">
                            <Binding Path="CurrentSignature.Digest" Converter="{StaticResource DigestTruncateConverter}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Verification outcome -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Border Background="{StaticResource SuccessSubtleBrush}" BorderBrush="{StaticResource SuccessSubtleBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Signature valid" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource DangerSubtleBrush}" BorderBrush="{StaticResource DangerSubtleBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Signature invalid" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
