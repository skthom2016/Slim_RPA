<!--
    Tracto Designer theme.

    A light Fluent/Windows 11 look built from plain WPF, with no external packages.
    Geometry follows the Windows 11 guidance: 4px corners on in-page controls,
    8px on cards and overlays.

    Icon glyphs come from Segoe Fluent Icons (Windows 11), falling back to
    Segoe MDL2 Assets on Windows 10.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ══ Palette ══════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#0F6CBD</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"   Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SubtleHoverBrush"     Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SubtlePressedBrush"   Color="#E4E4E4"/>
    <SolidColorBrush x:Key="BorderSoftBrush"      Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BorderBrushBase"      Color="#D8D8D8"/>
    <SolidColorBrush x:Key="BorderStrongBrush"    Color="#C4C4C4"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#616161"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"    Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextDisabledBrush"    Color="#A6A6A6"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"    Color="#FFFFFF"/>

    <SolidColorBrush x:Key="AccentBrush"          Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="#115EA3"/>
    <SolidColorBrush x:Key="AccentPressedBrush"   Color="#0E4775"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"    Color="#EFF6FC"/>

    <SolidColorBrush x:Key="SuccessBrush"         Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush"   Color="#E8F5E8"/>
    <SolidColorBrush x:Key="DangerBrush"          Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerSubtleBrush"    Color="#FDF0EF"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="#9D5D00"/>

    <!-- ══ Geometry and type ════════════════════════════════════════════════ -->
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="CaptionSize">12</sys:Double>
    <sys:Double x:Key="BodySize">13</sys:Double>
    <sys:Double x:Key="SubtitleSize">15</sys:Double>
    <sys:Double x:Key="TitleSize">19</sys:Double>

    <!-- ══ Text styles ══════════════════════════════════════════════════════ -->
    <Style TargetType="TextBlock" x:Key="BodyText">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="CaptionText" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize"   Value="{StaticResource CaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionTitle" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize"   Value="{StaticResource SubtitleSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="0,0,0,2"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="AppTitleText" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize"   Value="{StaticResource TitleSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Field label above an input -->
    <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize"   Value="{StaticResource CaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,3"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"/>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding"    Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment"        Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ══ Card ═════════════════════════════════════════════════════════════ -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{StaticResource CardRadius}"/>
        <Setter Property="Padding"         Value="12"/>
    </Style>

    <!-- ══ Buttons ══════════════════════════════════════════════════════════ -->

    <!-- Standard button: used for secondary actions inside panels. -->
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="14,0"/>
        <Setter Property="MinHeight"   Value="32"/>
        <Setter Property="MinWidth"    Value="80"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent button: the primary action of a panel. -->
    <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextOnAccentBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource AccentHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource AccentPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"  Value="#E1E1E1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E1E1E1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

    <!--
        Ribbon button: a large, easily clickable command with the icon above the
        label, in the manner of the Word and Excel ribbons. Set Tag to the icon glyph.
    -->
    <Style TargetType="Button" x:Key="RibbonButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource CaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth"   Value="62"/>
        <Setter Property="Height"     Value="66"/>
        <Setter Property="Margin"     Value="1,0"/>
        <Setter Property="Padding"    Value="5,6"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource CaptionSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon button that carries the primary action, tinted with the accent. -->
    <Style TargetType="Button" x:Key="RibbonAccentButton" BasedOn="{StaticResource RibbonButton}">
        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
    </Style>

    <!--
        Icon button: a compact square command, glyph only. Always give it a ToolTip,
        since the glyph carries the meaning. Set Tag to the icon glyph.
    -->
    <Style TargetType="Button" x:Key="IconButton">
        <Setter Property="Width"      Value="32"/>
        <Setter Property="Height"     Value="32"/>
        <Setter Property="Margin"     Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="15"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive icon button: turns red on hover so a delete reads as a delete. -->
    <Style TargetType="Button" x:Key="DangerIconButton" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="15"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"    Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd"    Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Inputs ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="9,0"/>
        <Setter Property="MinHeight"   Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="9,0"/>
        <Setter Property="MinHeight"   Value="30"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False"/>
                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton Opacity="0" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushBase}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardRadius}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0" Padding="3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"    Value="9,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="19" Height="19"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"  Property="Background"  Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box"  Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background"  Value="{StaticResource SubtleHoverBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Lists ════════════════════════════════════════════════════════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="3"/>
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource BodySize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"    Value="9,7"/>
        <Setter Property="Margin"     Value="0,1"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bar" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="Collapsed" Margin="0,2,7,2"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"  Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"     Value="3"/>
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource BodySize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of a list that has an ItemTemplate and no columns: it presents its content
         directly. A list laid out in columns needs GridViewRow below instead. -->
    <Style TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"    Value="7,5"/>
        <Setter Property="Margin"     Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of a list whose View is a GridView. Set it as that list's ItemContainerStyle:
         a column layout is presented by its columns, which the style above does not do. -->
    <Style x:Key="GridViewRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource CaptionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding"    Value="7,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="Transparent"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Progress, scrollbar, tooltip, status ═════════════════════════════ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"      Value="4"/>
        <Setter Property="Background"  Value="{StaticResource SubtlePressedBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                       Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushBase}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="9,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.14" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
                                    <Setter Property="FontSize"      Value="{StaticResource CaptionSize}"/>
                                    <Setter Property="Foreground"    Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="TextWrapping"  Value="Wrap"/>
                                    <Setter Property="MaxWidth"      Value="320"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding"     Value="12,0"/>
        <Setter Property="Height"      Value="30"/>
    </Style>

    <!-- ══ Tabs: used to group the panels below the editor ══════════════════ -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0" Panel.ZIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource BodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding"    Value="14,9"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Underline" Grid.Row="1" Height="2" CornerRadius="1"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                    Margin="2,3,2,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Status pill: a small coloured state badge ════════════════════════ -->
    <Style TargetType="Border" x:Key="Pill">
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="Padding"         Value="9,3"/>
        <Setter Property="Background"      Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ Ribbon group: buttons with a caption underneath ══════════════════ -->
    <Style TargetType="TextBlock" x:Key="RibbonGroupLabel" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground"          Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="FontSize"            Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin"              Value="0,2,0,0"/>
    </Style>

    <Style TargetType="Rectangle" x:Key="RibbonGroupSeparator">
        <Setter Property="Width"             Value="1"/>
        <Setter Property="Fill"              Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="Margin"            Value="4,8"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

</ResourceDictionary>
