<Window x:Class="Tracto.Designer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Tracto.Designer.App.Views"
        mc:Ignorable="d"
        Title="Tracto Designer" Width="1024" Height="768">
    <DockPanel LastChildFill="True">

        <!-- Top toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Label Content="Engine:" VerticalAlignment="Center" />
            <ComboBox Width="120"
                      ItemsSource="{Binding EngineTypes}"
                      SelectedItem="{Binding SelectedEngineType}" />
            <Separator />
            <Button Content="Start"   Command="{Binding StartCommand}"   Margin="2,0" />
            <Button Content="Pause"   Command="{Binding PauseCommand}"   Margin="2,0" />
            <Button Content="Resume"  Command="{Binding ResumeCommand}"  Margin="2,0" />
            <Button Content="Stop"          Command="{Binding StopCommand}"          Margin="2,0" />
            <Button Content="Discard"       Command="{Binding DiscardCommand}"       Margin="2,0" />
            <Separator />
            <Button Content="Generate Draft" Command="{Binding GenerateDraftCommand}" Margin="2,0" />
            <Separator />
            <Button Content="Validate" Command="{Binding Validation.ValidateCommand}" Margin="2,0" />
            <Separator />
            <Button Content="Run Test"  Command="{Binding TestRunner.RunTestCommand}"  Margin="2,0" />
            <Button Content="Stop Test" Command="{Binding TestRunner.StopTestCommand}" Margin="2,0" />
            <Separator />
            <Button Content="Start AI Bridge" Command="{Binding AiBridge.StartBridgeCommand}" Margin="2,0" />
            <Button Content="Stop AI Bridge"  Command="{Binding AiBridge.StopBridgeCommand}"  Margin="2,0" />
            <Separator />
            <Button Content="Sign"   Command="{Binding Signing.SignCommand}"   Margin="2,0" />
            <Button Content="Verify" Command="{Binding Signing.VerifyCommand}" Margin="2,0" />
            <Separator />
            <Button Content="Publish" Command="{Binding Publication.PublishCommand}" Margin="2,0" />
            <Separator />
            <Button Content="Export" Command="{Binding ExportImport.ExportCommand}" Margin="2,0" />
            <Button Content="Import" Command="{Binding ExportImport.ImportCommand}" Margin="2,0" />
        </ToolBar>

        <!-- Bottom status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentState}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding AiBridge.Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Script editor, validation panel, test panel, and signing panel -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <views:ScriptEditorControl Grid.Row="0" DataContext="{Binding ScriptEditor}"/>
            <views:ValidationPanel Grid.Row="1" DataContext="{Binding Validation}"/>
            <views:TestPanel Grid.Row="2" DataContext="{Binding TestRunner}"/>
            <views:SigningPanel Grid.Row="3" DataContext="{Binding Signing}"/>
            <views:PublicationPanel Grid.Row="4" DataContext="{Binding Publication}"/>
        </Grid>

    </DockPanel>
</Window>
