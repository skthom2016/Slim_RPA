<Window x:Class="Tracto.Designer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Tracto.Designer.App.Views"
        mc:Ignorable="d"
        Title="Tracto Designer" Width="1280" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- ══ Header: app name and the live session state ══════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE759;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tracto Designer" Style="{StaticResource AppTitleText}" Margin="11,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Session" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource Pill}"
                            Background="{StaticResource AccentSubtleBrush}"
                            BorderBrush="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding CurrentState}" Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Ribbon: large grouped commands ══════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="12,8">

                    <!-- Script -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonAccentButton}" Tag="&#xE7C3;"
                                    Content="New Script" Command="{Binding NewScriptCommand}"
                                    ToolTip="Clear the editor and the recording session, ready for another flow."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE8E5;"
                                    Content="Import" Command="{Binding ExportImport.ImportCommand}"
                                    ToolTip="Open a script file into the editor."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE74E;"
                                    Content="Export" Command="{Binding ExportImport.ExportCommand}"
                                    ToolTip="Save the open script to a file."/>
                        </StackPanel>
                        <TextBlock Text="Script" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}"/>

                    <!-- Browser: the one signed-in browser every signed-in segment shares -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE77B;"
                                    Content="Sign in" Command="{Binding ProfileSignIn.SignInCommand}"
                                    ToolTip="Opens the signed-in browser for this machine. Sign in to the sites your scripts need, then close the window. Segments set to &quot;Signed-in browser&quot; all use it."/>
                        </StackPanel>
                        <TextBlock Text="Browser" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}"/>

                    <!-- Record -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE768;"
                                    Content="Start" Command="{Binding StartCommand}"
                                    ToolTip="Start recording into the selected segment."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE769;"
                                    Content="Pause" Command="{Binding PauseCommand}"
                                    ToolTip="Pause recording."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE768;"
                                    Content="Resume" Command="{Binding ResumeCommand}"
                                    ToolTip="Carry on recording after a pause."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE71A;"
                                    Content="Stop" Command="{Binding StopCommand}"
                                    ToolTip="Stop recording and keep what was captured."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE894;"
                                    Content="Discard" Command="{Binding DiscardCommand}"
                                    ToolTip="Throw away the current recording."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE8A5;"
                                    Content="Generate&#x0a;Draft" Command="{Binding GenerateDraftCommand}"
                                    ToolTip="Turn the recorded actions into steps in the editor."/>
                        </StackPanel>
                        <TextBlock Text="Record" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}"/>

                    <!-- Check -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE73E;"
                                    Content="Validate" Command="{Binding Validation.ValidateCommand}"
                                    ToolTip="Check the script for problems."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE9F5;"
                                    Content="Run Test" Command="{Binding TestRunner.RunTestCommand}"
                                    ToolTip="Run the script through the test runner."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE71A;"
                                    Content="Stop Test" Command="{Binding TestRunner.StopTestCommand}"
                                    ToolTip="Stop the running test."/>
                        </StackPanel>
                        <TextBlock Text="Check" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}"/>

                    <!-- Release -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE72E;"
                                    Content="Sign" Command="{Binding Signing.SignCommand}"
                                    ToolTip="Sign the script."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE8FB;"
                                    Content="Verify" Command="{Binding Signing.VerifyCommand}"
                                    ToolTip="Check the script's signature."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE898;"
                                    Content="Publish" Command="{Binding Publication.PublishCommand}"
                                    ToolTip="Publish the script so a runtime can fetch it."/>
                        </StackPanel>
                        <TextBlock Text="Release" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}"/>

                    <!-- AI bridge -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE99A;"
                                    Content="Start&#x0a;Bridge" Command="{Binding AiBridge.StartBridgeCommand}"
                                    ToolTip="Start the AI authoring bridge."/>
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE894;"
                                    Content="Stop&#x0a;Bridge" Command="{Binding AiBridge.StopBridgeCommand}"
                                    ToolTip="Stop the AI authoring bridge."/>
                        </StackPanel>
                        <TextBlock Text="AI Bridge" Style="{StaticResource RibbonGroupLabel}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Status bar ══════════════════════════════════════════════════ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentState}" Style="{StaticResource CaptionText}" Margin="6,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding AiBridge.Status}" Style="{StaticResource CaptionText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ProfileSignIn.Status}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" MaxWidth="460"
                           Visibility="{Binding ProfileSignIn.Status, Converter={StaticResource TextToVisibilityConverter}}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ExportImport.LastMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" MaxWidth="460"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ══ Work area: the editor above, the panels in tabs below ═══════ -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="238" MinHeight="140"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <views:ScriptEditorControl DataContext="{Binding ScriptEditor}"/>
            </Border>

            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" Background="Transparent"
                          VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <TabControl Margin="4,2,4,4">
                    <TabItem Header="Validation">
                        <views:ValidationPanel DataContext="{Binding Validation}"/>
                    </TabItem>
                    <TabItem Header="Test Run">
                        <views:TestPanel DataContext="{Binding TestRunner}"/>
                    </TabItem>
                    <TabItem Header="Signing">
                        <views:SigningPanel DataContext="{Binding Signing}"/>
                    </TabItem>
                    <TabItem Header="Publish">
                        <views:PublicationPanel DataContext="{Binding Publication}"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

    </DockPanel>
</Window>
