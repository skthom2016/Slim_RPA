uto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="a13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="540"/><mxPoint x="1230" y="1732"/></Array></mxGeometry></mxCell><mxCell id="f5_e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="a13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="410"/><mxPoint x="1260" y="1754"/></Array></mxGeometry></mxCell><mxCell id="n5" value="&lt;b&gt;What bot_run.py does (Bot 1)&lt;/b&gt;&lt;br&gt;loads today's International hand-off workbooks, downloads outstanding, bank statement, unapplied and customer master from Oracle Fusion, writes B2 / B3, creates receipts, matches and posts as switched.&lt;br&gt;&lt;br&gt;&lt;b&gt;Points&lt;/b&gt;&lt;br&gt;• One run per database at a time; a second successful run on the same day is refused, because it duplicates receipts.&lt;br&gt;• The Python code is not changed.&lt;br&gt;• Bot 3 is started by a person from the web page (run-bot-sxp.php) on the same database: avoid 07:55.&lt;br&gt;• MSS_SXP_BotRun.xlsx is filled to 31 Dec 2026; Go warns when fewer than 30 days are left.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;• Who extends MSS_SXP_BotRun.xlsx; what increments active_bot_run_id.&lt;br&gt;• Exact time zone of 07:55; whether the bank check result should start the run." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="520" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>