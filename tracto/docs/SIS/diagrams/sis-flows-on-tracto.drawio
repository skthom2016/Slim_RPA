thogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a13" target="a4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="1710"/><mxPoint x="50" y="540"/></Array></mxGeometry></mxCell><mxCell id="f4_e29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a13" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n4" value="&lt;b&gt;Points&lt;/b&gt;&lt;br&gt;• Each document is one step of the Go API loop, not a child job.&lt;br&gt;• Customer-specific handling is rows of the rules table.&lt;br&gt;• No review screen: an advice that fails a check is held back and reported.&lt;br&gt;• A busy or timed-out Extraction API holds the item; it is not failed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;• PDF password list and owner; 20 locked International PDFs.&lt;br&gt;• Review threshold; the release path for a reviewed document." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f5" name="8 Flow 5 International run"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow 5 · International collection accounting run (carun-main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="ref" value="Reference: replaces the UiPath process &lt;b&gt;International_Bot1_SXP&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="Orchestrator schedule fires (07:55 Australia/Sydney, after flow 4) or Run now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="113" width="300" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Desktop runtime runs &lt;b&gt;carun-main&lt;/b&gt;: one HTTP call to the Go API; Go answers accepted; the job ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="300" height="90" as="geometry"/></mxCell><mxCell id="f5_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Already succeeded today on this database?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="355" width="260" height="110" as="geometry"/></mxCell><mxCell id="b3" value="Refuse (unless forced); record why&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="373" width="300" height="74" as="geometry"/></mxCell>