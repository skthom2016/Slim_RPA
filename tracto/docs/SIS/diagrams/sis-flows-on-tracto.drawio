=0;" edge="1" parent="1" source="a17" target="a4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="2360"/><mxPoint x="20" y="540"/></Array></mxGeometry></mxCell><mxCell id="f2_e31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a17" target="a18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n2" value="&lt;b&gt;Points&lt;/b&gt;&lt;br&gt;• Mail, files and spreadsheets only: no window is driven.&lt;br&gt;• An archive is deleted only after every inner file has an outcome.&lt;br&gt;• A mail is recorded as processed after its work items exist, so a rerun never repeats it.&lt;br&gt;• Passwords are never logged.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;• Mailbox list, Microsoft 365 or in-house server, Graph permissions.&lt;br&gt;• Which spreadsheets flow 3 reads: XLS\ or the PA_ copies.&lt;br&gt;• Work items: PostgreSQL table (default) or a sheet." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f3" name="6 Flow 3 Spreadsheets"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow 3 · Spreadsheet advices (excelextract-main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="ref" value="Reference: replaces the UiPath process &lt;b&gt;India.Excel.Extraction&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="Orchestrator schedule fires (Indian: no schedule, the SPOC starts it) or Run now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="113" width="300" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Desktop runtime runs &lt;b&gt;excelextract-main&lt;/b&gt;: one HTTP call to the Go API; Go answers accepted; the job ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="300" height="90" as="geometry"/></mxCell><mxCell id="f3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Read the entity table and the format profiles (sheet, columns, mapping)&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="368" width="300" height="84" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;MasterConfig.xlsx, format profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="373" width="200" height="74" as="geometry"/></mxCell><mxCell id="a4" value="For each entity (DTSS skipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="503" width="300" height="74" as="geometry"/></mxCell><mxCell id="a5" value="List today's spreadsheet advices for the entity&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="633" width="300" height="74" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;Payment Advices\{date}\{entity}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="633" width="200" height="74" as="geometry"/></mxCell><mxCell id="a6" value="For each file (own status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="763" width="300" height="74" as="geometry"/></mxCell><mxCell id="a7" value="Read the sheet names and the header row&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="893" width="300" height="74" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;the advice workbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="893" width="200" height="74" as="geometry"/></mxCell><mxCell id="a8" value="Sheet and columns match the profile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1005" width="260" height="110" as="geometry"/></mxCell><mxCell id="b8" value="Mail the format rejection to the sender; file Failed with the reason&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go mail API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="1015" width="300" height="90" as="geometry"/></mxCell><mxCell id="a9" value="Clean and map: '-' → blank, empty TDS / Other Deductions → 0, spaces collapsed; dates, amounts, IDs normalised&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1140" width="300" height="100" as="geometry"/></mxCell><mxCell id="a10" value="Keep the rows for the day workbook; copy the source to the archive; file Done&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1275" width="300" height="90" as="geometry"/></mxCell><mxCell id="r10" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;Extracted Standard Excel Advices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="1283" width="200" height="74" as="geometry"/></mxCell><mxCell id="a11" value="More files?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1398" width="260" height="104" as="geometry"/></mxCell><mxCell id="a12" value="Write the day workbook once (duplicate guard) and its timestamped copy&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1535" width="300" height="90" as="geometry"/></mxCell><mxCell id="r12" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;Excel\Extractor_ExtractedFiles\{date}\{entity}\Extracted Payment Advices.xlsx" style="rounded=1;whiteSpace=wrap;html=1;f