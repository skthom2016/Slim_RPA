<mxfile host="app.diagrams.net"><diagram id="ov" name="1 Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="SIS payment advices on Tracto: the five flows and how they hand over" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="mbox" value="&lt;b&gt;Entity mailboxes&lt;/b&gt;&lt;br&gt;Microsoft 365 or mail.sisindia.com&lt;br&gt;customers send payment advices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="240" height="110" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Flow 2 · Mail dispatch&lt;/b&gt;&lt;br&gt;main job maildispatch-main&lt;br&gt;→ Go API&lt;br&gt;&lt;i&gt;Indian 10:00 · International 05:45 Australia&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="240" height="120" as="geometry"/></mxCell><mxCell id="fold" value="&lt;b&gt;Dated folders per entity&lt;/b&gt;&lt;br&gt;PDF_JPEG · XLS · MailBody · PA_ files&lt;br&gt;+ one work item per file" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="240" height="140" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Flow 3 · Spreadsheet advices&lt;/b&gt;&lt;br&gt;main job excelextract-main&lt;br&gt;→ Go API&lt;br&gt;&lt;i&gt;Indian: SPOC presses Run now&lt;br&gt;DTSS sends none&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="240" height="120" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;Flow 4 · PDF and image advices&lt;/b&gt;&lt;br&gt;main job padvice-main&lt;br&gt;→ Go API&lt;br&gt;&lt;i&gt;Indian: SPOC presses Run now&lt;br&gt;International 05:49 Australia&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="240" height="120" as="geometry"/></mxCell><mxCell id="xsvc" value="&lt;b&gt;Extraction API&lt;/b&gt;&lt;br&gt;extraction service (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="240" height="80" as="geometry"/></mxCell><mxCell id="hand" value="&lt;b&gt;Hand-off workbooks&lt;/b&gt;&lt;br&gt;one per entity per day, under&lt;br&gt;ExtractedPaymentAdvices\Excel\...&lt;br&gt;and ExtractedPaymentAdvices\PDF_JPEG\..." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1320" y="255" width="240" height="150" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Indian entities&lt;/b&gt;&lt;br&gt;a person clicks Start Process&lt;br&gt;on the web page ca_with_pa&lt;br&gt;&lt;i&gt;unchanged, outside Tracto&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="1640" y="110" width="240" height="120" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;Flow 5 · International run (SXP)&lt;/b&gt;&lt;br&gt;main job carun-main&lt;br&gt;→ Go API&lt;br&gt;&lt;i&gt;07:55 Australia, after flow 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1640" y="440" width="240" height="120" as="geometry"/></mxCell><mxCell id="f5m" value="&lt;b&gt;Result mail&lt;/b&gt;&lt;br&gt;reports attached / API down /&lt;br&gt;no bank statement / run failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1640" y="655" width="240" height="90" as="geometry"/></mxCell><mxCell id="pyin" value="&lt;b&gt;Collection accounting&lt;/b&gt;&lt;br&gt;Indian copy: bot_run.py&lt;br&gt;MySQL collection_accounting" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1960" y="110" width="240" height="120" as="geometry"/></mxCell><mxCell id="pyint" value="&lt;b&gt;Collection accounting&lt;/b&gt;&lt;br&gt;International Bot 1: run_SXP_bot.bat&lt;br&gt;MySQL ca_with_pa_sxp" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1960" y="440" width="240" height="120" as="geometry"/></mxCell><mxCell id="bot3" value="&lt;b&gt;Bot 3&lt;/b&gt; (International matching, posting, reconciliation reports)&lt;br&gt;a person starts it from the web page: run-bot-sxp.php&lt;br&gt;&lt;i&gt;unchanged, outside Tracto&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="1960" y="645" width="240" height="110" as="geometry"/></mxCell><mxCell id="orac" value="&lt;b&gt;Oracle Fusion&lt;/b&gt;&lt;br&gt;through Magic xpi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2280" y="280" width="240" height="100" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Flow 1 · Bank statement availability&lt;/b&gt;&lt;br&gt;main job bankcheck-main → Go API&lt;br&gt;Indian and International entities&lt;br&gt;&lt;i&gt;Indian 11:00 and 11:30 · International 07:00 Australia&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="860" width="240" height="120" as="geometry"/></mxCell><mxCell id="stmt" value="&lt;b&gt;Bank statement folders&lt;/b&gt;&lt;br&gt;Statements1\BankStatements\&lt;br&gt;{date}\{entity}" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="865" width="240" height="110" as="geometry"/></mxCell><mxCell id="fetch" value="&lt;b&gt;Fetch bots&lt;/b&gt; (Python download)&lt;br&gt;Indian: run_Bank_bot.bat&lt;br&gt;International: run_Bank_bot_{entity}.bat" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="1060" width="240" height="100" as="geometry"/></mxCell><mxCell id="f1m" value="&lt;b&gt;MT940 status mails&lt;/b&gt;&lt;br&gt;available entities,&lt;br&gt;unavailable accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="240" height="100" as="geometry"/></mxCell><mxCell id="ov_e1" value="unread mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="mbox" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e2" value="replies to the sender" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="mbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e3" value="files + work items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="fold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e4" value="PA_ / XLS files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fold" target="f3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="302"/><mxPoint x="945" y="180"/></Array></mxGeometry></mxCell><mxCell id="ov_e5" value="PDF_JPEG work items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fold" target="f4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="358"/><mxPoint x="975" y="500"/></Array></mxGeometry></mxCell><mxCell id="ov_e6" value="each document" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="f4" target="xsvc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e7" value="writes the day workbook once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="hand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="180"/><mxPoint x="1270" y="300"/></Array></mxGeometry></mxCell><mxCell id="ov_e8" value="writes the day workbook once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4" target="hand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="500"/><mxPoint x="1290" y="360"/></Array></mxGeometry></mxCell><mxCell id="ov_e9" value="loaded by bot_run.py" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="hand" target="pyin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2044" y="307"/></Array></mxGeometry></mxCell><mxCell id="ov_e10" value="loaded by bot_run.py" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hand" target="pyint"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2116" y="352"/></Array></mxGeometry></mxCell><mxCell id="ov_e11" value="runs bot_run.py" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="pyin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e12" value="runs the batch file,&lt;br&gt;reads B2 / B3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f5" target="pyint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f5" target="f5m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e14" value="download, receipts, posting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pyin" target="orac"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="170"/></Array></mxGeometry></mxCell><mxCell id="ov_e15" value="download, receipts, posting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pyint" target="orac"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="500"/></Array></mxGeometry></mxCell><mxCell id="ov_e16" value="same database" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="pyint" target="bot3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e17" value="today's folder there?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="stmt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e18" value="runs it when missing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="fetch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1110"/></Array></mxGeometry></mxCell><mxCell id="ov_e19" value="downloads into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fetch" target="stmt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_e20" value="sends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f1m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ovnote" value="&lt;b&gt;Five separate flows.&lt;/b&gt; Each one starts the same way: an Orchestrator schedule (or Run now) starts a one-step main job on the desktop runtime; that step makes one HTTP call to the Go API and the job ends. The Go API then loops over the entities, files or documents, with a status per item, calling the Sheet API, Go file API, Go mail API, Go program runner, Go work-item API and Extraction API as needed (page 2).&lt;br&gt;&lt;br&gt;Indian and International entities go through flows 1 to 4 with their own entity profile and schedule time zone. Flow 5 is International only.&lt;br&gt;&lt;br&gt;The flows never call each other: they hand over through folders, work items and the hand-off workbooks. The collection accounting Python code is not changed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="830" width="560" height="300" as="geometry"/></mxCell><mxCell id="lgt" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="830" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1640" y="870" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl0" value="Trigger" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="870" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1640" y="910" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl1" value="Main job (desktop runtime)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="910" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1640" y="950" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl2" value="Go API step" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="950" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1640" y="990" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl3" value="API the Go API calls" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="990" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1640" y="1030" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl4" value="Decision" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1030" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1640" y="1070" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl5" value="Mail sent" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1070" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1640" y="1110" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl6" value="Failure or rejection path" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1110" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg7" value="" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="1150" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl7" value="Folder or workbook" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1150" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg8" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="1190" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl8" value="Program and database" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1190" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg9" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="1230" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl9" value="External system" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1230" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="1640" y="1270" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl10" value="Done by a person" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1270" width="300" height="30" as="geometry"/></mxCell><mxCell id="lg11" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1640" y="1310" width="50" height="30" as="geometry"/></mxCell><mxCell id="lgl11" value="Open question" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="1310" width="300" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cc" name="2 Components and calls"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Tracto components and who calls whom" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;sets up schedules, Run now, checks runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Orchestrator UI&lt;/b&gt; (4000)&lt;br&gt;Schedules, Jobs, Logs, Work items pages" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="260" height="90" as="geometry"/></mxCell><mxCell id="orc" value="&lt;b&gt;Orchestrator&lt;/b&gt; (5080, PostgreSQL)&lt;br&gt;scheduler, job queue, main job scripts, run records" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="300" height="90" as="geometry"/></mxCell><mxCell id="dr" value="&lt;b&gt;Desktop runtime&lt;/b&gt;&lt;br&gt;runs the one-step main job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="260" height="90" as="geometry"/></mxCell><mxCell id="cc_e1" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="op" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="ui" target="orc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e3" value="hands out the job /&lt;br&gt;gets the result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="orc" target="dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="goapi" value="&lt;b&gt;Go API: the SIS flow service&lt;/b&gt;&lt;br&gt;one start point per flow: bank check, mail dispatch, spreadsheet advices, PDF advices, International run.&lt;br&gt;It answers the main job at once (accepted, with a batch id; busy if that flow is already running), then works through the items in the background with a status per item." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="1860" height="110" as="geometry"/></mxCell><mxCell id="cc_e4" value="one HTTP call: start the flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45698924731182794;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dr" target="goapi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sheet" value="&lt;b&gt;Sheet API&lt;/b&gt; (sheet-service, 5090)&lt;br&gt;read sheets, write cells, append rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="360" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="sheet_t" value="&lt;b&gt;Workbooks&lt;/b&gt;&lt;br&gt;MasterConfig, BankMaster, customer list, trackers, hand-off workbooks" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e5" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.07526881720430108;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="sheet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="sheet" target="sheet_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fsapi" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;exists, list, create, copy, move, delete, unzip inside allowed folders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="676" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="fsapi_t" value="&lt;b&gt;Folders&lt;/b&gt;&lt;br&gt;E:\Automation\... and the statement folders" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="676" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e7" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.24516129032258063;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="fsapi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="fsapi" target="fsapi_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail" value="&lt;b&gt;Go mail API&lt;/b&gt;&lt;br&gt;read unread mail, save attachments, send, reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="992" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="mail_t" value="&lt;b&gt;Mailboxes&lt;/b&gt;&lt;br&gt;Microsoft Graph (365) or IMAP / SMTP (mail.sisindia.com)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="992" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e9" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.4150537634408602;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="mail" target="mail_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run" value="&lt;b&gt;Go program runner&lt;/b&gt;&lt;br&gt;runs a named batch file with a timeout; exit code and output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1308" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="run_t" value="&lt;b&gt;Python programs&lt;/b&gt;&lt;br&gt;run_Bank_bot.bat, run_Bank_bot_{entity}.bat, run_SXP_bot.bat → MySQL, Oracle Fusion" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1308" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e11" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5849462365591398;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="run" target="run_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wi" value="&lt;b&gt;Go work-item API&lt;/b&gt;&lt;br&gt;add, claim, complete, fail; attempt count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1624" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="wi_t" value="&lt;b&gt;Work-item table&lt;/b&gt;&lt;br&gt;PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1624" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e13" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.7548387096774194;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="wi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="wi" target="wi_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ex" value="&lt;b&gt;Extraction API&lt;/b&gt; (extraction service)&lt;br&gt;reads one PDF or image, returns fields and invoice lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1940" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="ex_t" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;two readings and colours per field" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1940" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="cc_e15" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.9247311827956989;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="goapi" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="ex" target="ex_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ccnote" value="&lt;b&gt;What exists and what is to build&lt;/b&gt;&lt;br&gt;• Orchestrator, Orchestrator UI, desktop runtime, schedules: exist.&lt;br&gt;• Sheet API: exists for reading and cell writes; appending rows and creating a workbook are to build.&lt;br&gt;• Go API (the five start points and loops), Go file API, Go mail API, Go program runner, Go work-item API: to build.&lt;br&gt;• Extraction API: exists; password unlock and image input are with the module team.&lt;br&gt;• Which Go module hosts the Go API and the platform APIs (sheet-service or a new module) is still to decide.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule:&lt;/b&gt; no job waits for another job; only the Go API waits. The desktop runtime never drives a window or a browser in these flows." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="900" width="1200" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tr" name="3 How a flow runs"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How every flow starts and runs (same for all five)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh0" value="Operator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh1" value="Orchestrator UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh2" value="Orchestrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="lane3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh3" value="Desktop runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="lane4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh4" value="Go API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="lane5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="80" width="260" height="1360" as="geometry"/></mxCell><mxCell id="lh5" value="Sheet, file, mail, program, work-item, Extraction APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1540" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Set up once per flow&lt;/b&gt;&lt;br&gt;publish the main job &amp;lt;flow&amp;gt;-main (one HTTP step) and create its schedule: time, time zone, params" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="55" y="155" width="230" height="110" as="geometry"/></mxCell><mxCell id="s2" value="Schedules page lists upcoming and completed runs" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Run now&lt;/b&gt;, or rerun for one entity or date&lt;br&gt;(force for flow 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="55" y="435" width="230" height="90" as="geometry"/></mxCell><mxCell id="s3" value="At the scheduled time, queue a job for &amp;lt;flow&amp;gt;-main with the schedule's params" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="435" width="230" height="90" as="geometry"/></mxCell><mxCell id="s4" value="Pick up the job and run its one step: an HTTP call to the Go API to start the flow, with the params" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="955" y="565" width="230" height="100" as="geometry"/></mxCell><mxCell id="s5" value="Check the params; create a batch and one item per entity, file or document; answer at once: &lt;b&gt;accepted&lt;/b&gt; + batch id (or busy / invalid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1255" y="695" width="230" height="110" as="geometry"/></mxCell><mxCell id="s6" value="Step done: report the result. The job ends in seconds; no window, no browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="955" y="840" width="230" height="90" as="geometry"/></mxCell><mxCell id="s6b" value="Run record: SUCCEEDED, batch id in the outputs (FAILED if busy, invalid or Go API down)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="835" width="230" height="100" as="geometry"/></mxCell><mxCell id="s7" value="Work through the items in the background: each item Pending → Running → Done / Failed / Held, retried by attempt count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1255" y="960" width="230" height="120" as="geometry"/></mxCell><mxCell id="s8" value="Each step calls the API it needs (see the flow pages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1555" y="975" width="230" height="90" as="geometry"/></mxCell><mxCell id="s9" value="Send the flow's mails and record the batch result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1255" y="1110" width="230" height="90" as="geometry"/></mxCell><mxCell id="s10" value="Go mail API sends through Microsoft Graph (or SMTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1555" y="1110" width="230" height="90" as="geometry"/></mxCell><mxCell id="s11" value="Console: run state, batch result, each item's status and reason; alert mail on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="355" y="1240" width="230" height="100" as="geometry"/></mxCell><mxCell id="s12" value="Check the outcome; rerun failed items or one entity with Run now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1"><mxGeometry x="55" y="1380" width="230" height="90" as="geometry"/></mxCell><mxCell id="tr_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e3" value="Run now" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e4" value="job handed out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e5" value="HTTP call: start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e6" value="accepted + batch id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e7" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s6b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e8" value="continues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="750"/><mxPoint x="1505" y="990"/></Array></mxGeometry></mxCell><mxCell id="tr_e9" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e12" value="batch result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tbl" value="&lt;b&gt;The five main jobs&lt;/b&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr&gt;&lt;th&gt;Flow&lt;/th&gt;&lt;th&gt;Replaces UiPath&lt;/th&gt;&lt;th&gt;Main job&lt;/th&gt;&lt;th&gt;When&lt;/th&gt;&lt;th&gt;Entities&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1 Bank statement availability&lt;/td&gt;&lt;td&gt;BankAvailCheck&lt;/td&gt;&lt;td&gt;bankcheck-main&lt;/td&gt;&lt;td&gt;Indian 11:00 and 11:30; International 07:00 Australia&lt;/td&gt;&lt;td&gt;Indian and International (MSS-Security, Southern-Cross-Protection)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2 Mail dispatch&lt;/td&gt;&lt;td&gt;EmailPADispatcher&lt;/td&gt;&lt;td&gt;maildispatch-main&lt;/td&gt;&lt;td&gt;Indian 10:00; International 05:45 Australia&lt;/td&gt;&lt;td&gt;Indian and International&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3 Spreadsheet advices&lt;/td&gt;&lt;td&gt;India.Excel.Extraction&lt;/td&gt;&lt;td&gt;excelextract-main&lt;/td&gt;&lt;td&gt;Indian: SPOC, Run now&lt;/td&gt;&lt;td&gt;Indian and International, not DTSS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4 PDF and image advices&lt;/td&gt;&lt;td&gt;Payment.Advice.Extraction&lt;/td&gt;&lt;td&gt;padvice-main&lt;/td&gt;&lt;td&gt;International 05:49 Australia; Indian: SPOC, Run now&lt;/td&gt;&lt;td&gt;Indian and International&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5 International collection accounting run&lt;/td&gt;&lt;td&gt;International_Bot1_SXP&lt;/td&gt;&lt;td&gt;carun-main&lt;/td&gt;&lt;td&gt;07:55 Australia/Sydney, after flow 4&lt;/td&gt;&lt;td&gt;International (SXP) only&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Each main job has one step: an HTTP call to the Go API. The Indian collection accounting run stays a person's click on the web page ca_with_pa." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="1300" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f1" name="4 Flow 1 Bank check"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow 1 · Bank statement availability (bankcheck-main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="ref" value="Reference: replaces the UiPath process &lt;b&gt;BankAvailCheck and InternationalBankAvailCheck&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="Orchestrator schedule fires (Indian 11:00 and 11:30; International 07:00 Australia) or Run now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="113" width="300" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Desktop runtime runs &lt;b&gt;bankcheck-main&lt;/b&gt;: one HTTP call to the Go API; Go answers accepted; the job ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="300" height="90" as="geometry"/></mxCell><mxCell id="f1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Read the settings and the entity table (Indian and International rows); today's date in the schedule's time zone&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="300" height="100" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;MasterConfig.xlsx, BankMaster.xlsx, BankMasterInternational.xlsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="365" width="200" height="90" as="geometry"/></mxCell><mxCell id="a4" value="For each entity (each has its own outcome)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="503" width="300" height="74" as="geometry"/></mxCell><mxCell id="a5" value="Today's statement folder for the entity exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="610" width="280" height="120" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;the entity's statement root \{date}\{entity}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="625" width="200" height="90" as="geometry"/></mxCell><mxCell id="b5" value="Write the entity into its bank workbook, EntitySelected!A2&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Sheet API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="628" width="300" height="84" as="geometry"/></mxCell><mxCell id="b6" value="Run the entity's fetch bot and wait (timeout, exit code, output kept)&lt;br&gt;&lt;i&gt;Indian run_Bank_bot.bat · International run_Bank_bot_{entity}.bat&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go program runner&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="745" width="300" height="110" as="geometry"/></mxCell><mxCell id="b7" value="Folder exists now?&lt;br&gt;&lt;i&gt;(Go file API)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="875" width="260" height="110" as="geometry"/></mxCell><mxCell id="a7" value="Mark the entity available&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="893" width="300" height="74" as="geometry"/></mxCell><mxCell id="b8" value="Read the check workbook and the entity's bank sheet; list accounts with AVAILABLE = N&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Sheet API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="1010" width="300" height="100" as="geometry"/></mxCell><mxCell id="b9" value="Tries left for this entity?&lt;br&gt;&lt;i&gt;International: every 5 min&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="1135" width="260" height="110" as="geometry"/></mxCell><mxCel