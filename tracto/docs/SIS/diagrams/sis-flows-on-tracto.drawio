nded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="a11" target="r11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a11" target="a12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1_e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a12" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1_e24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a12" target="a13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="a13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1970"/></Array></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Points&lt;/b&gt;&lt;br&gt;• The desktop runtime only starts the flow; the Go API does the whole loop.&lt;br&gt;• One failing entity does not stop the others.&lt;br&gt;• Each entity row says what differs: statement root, bank workbook, fetch bot, recipients, retry (Indian: none; International: every 5 min, with a limit).&lt;br&gt;• The fetch bots are console programs that always end with exit code 0, so the folder check after them is the result.&lt;br&gt;&lt;br&gt;• All three fetch bots read their window from Bot_run_Configurations.xlsx, which differs from flow 5's calendar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;• Which calendar rule is right; the note row in the supplied file.&lt;br&gt;• International: how many tries; what reads the success queue; MSS-Security checked or not." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f2" name="5 Flow 2 Mail dispatch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow 2 · Mail dispatch (maildispatch-main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="ref" value="Reference: replaces the UiPath process &lt;b&gt;EmailPADispatcher&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="Orchestrator schedule fires (Indian 10:00; International 05:45 Australia) or Run now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="113" width="300" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Desktop runtime runs &lt;b&gt;maildispatch-main&lt;/b&gt;: one HTTP call to the Go API; Go answers accepted; the job ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="300" height="90" as="geometry"/></mxCell><mxCell id="f2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Read the entity table: mailbox, accepted file types, recipients&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="368" width="300" height="84" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;MasterConfig.xlsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="373" width="200" height="74" as="geometry"/></mxCell><mxCell id="a4" value="For each entity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="503" width="300" height="74" as="geometry"/></mxCell><mxCell id="a5" value="Fetch unread mail not yet processed&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="633" width="300" height="74" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Go mail API&lt;/b&gt;&lt;br&gt;Graph (Microsoft 365) or IMAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="633" width="200" height="74" as="geometry"/></mxCell><mxCell id="a6" value="Create {date}\{entity}\PDF_JPEG, XLS, MailBody&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="763" width="300" height="74" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;Payment Advices folders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="763" width="200" height="74" as="geometry"/></mxCell><mxCell id="a7" value="Read the customer list for the entity&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="893" width="300" height="74" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;Customers List.xlsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="893" width="200" height="74" as="geometry"/></mxCell><mxCell id="a7b" value="Pre-download: mails with PA_{entity} in the first attachment or subject → all attachments to {date}\{entity}\&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go mail API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1012" width="300" height="96" as="geometry"/></mxCell><mxCell id="a8" value="For each mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="1153" width="300" height="74" as="geometry"/></mxCell><mxCell id="a9" value="Identify the customer from keywords in the body (first match; else Others)&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1278" width="300" height="84" as="geometry"/></mxCell><mxCell id="a10" value="Has attachments?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1398" width="260" height="104" as="geometry"/></mxCell><mxCell id="b10" value="Save the mail as .eml in MailBody; one work item (mail body)&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go mail API, Go work-item API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="1405" width="300" height="90" as="geometry"/></mxCell><mxCell id="a11" value="Save attachments; route by type:&lt;br&gt;pdf / jpg / jpeg → PDF_JPEG&lt;br&gt;xls / xlsx → XLS (not DTSS)&lt;br&gt;zip → unzip, route each inner file&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1522" width="300" height="116" as="geometry"/></mxCell><mxCell id="r11" value="&lt;b&gt;Go mail API&lt;/b&gt; saves&lt;br&gt;&lt;b&gt;Go file API&lt;/b&gt; unzips, moves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="1538" width="200" height="84" as="geometry"/></mxCell><mxCell id="a12" value="File handled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1658" width="260" height="104" as="geometry"/></mxCell><mxCell id="b12" value="Reply to the sender only (failed archive, missing file, unsupported type); outcome Failed&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go mail API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="1660" width="300" height="100" as="geometry"/></mxCell><mxCell id="a13" value="Rename {customer}_{dd MMM yyyy hh mm ss}_{n}{ext}; one work item per file&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go file API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1795" width="300" height="90" as="geometry"/></mxCell><mxCell id="r13" value="&lt;b&gt;Go work-item API&lt;/b&gt;&lt;br&gt;work items (PostgreSQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="1803" width="200" height="74" as="geometry"/></mxCell><mxCell id="a14" value="Record the outcome for the Email Tracker&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1933" width="300" height="74" as="geometry"/></mxCell><mxCell id="a15" value="More mails?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="2048" width="260" height="104" as="geometry"/></mxCell><mxCell id="a16" value="Append the Email Tracker; record the entity's outcome and mail count&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="2188" width="300" height="84" as="geometry"/></mxCell><mxCell id="r16" value="&lt;b&gt;Sheet API&lt