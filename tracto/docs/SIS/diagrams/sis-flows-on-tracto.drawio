e;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a11" target="a6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="1450"/><mxPoint x="50" y="800"/></Array></mxGeometry></mxCell><mxCell id="f3_e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a11" target="a12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3_e22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a13" target="a4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1710"/><mxPoint x="20" y="540"/></Array></mxGeometry></mxCell><mxCell id="f3_e23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a13" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n3" value="&lt;b&gt;Points&lt;/b&gt;&lt;br&gt;• One profile row per entity: adding an entity is adding a row.&lt;br&gt;• A workbook in the wrong format fails on its own; the other files still run.&lt;br&gt;• The day workbook is written once per entity, so a rerun does not add rows twice.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;&lt;br&gt;• Spreadsheet formats of the entities other than DTSS.&lt;br&gt;• XLS\ folder or PA_ copies.&lt;br&gt;• Which cleaning rules are wanted." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa600;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f4" name="7 Flow 4 PDF advices"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow 4 · PDF and image advices (padvice-main)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="ref" value="Reference: replaces the UiPath process &lt;b&gt;Payment.Advice.Extraction&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="Orchestrator schedule fires (International 05:49 Australia; Indian: no schedule, the SPOC starts it) or Run now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="113" width="300" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Desktop runtime runs &lt;b&gt;padvice-main&lt;/b&gt;: one HTTP call to the Go API; Go answers accepted; the job ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="300" height="90" as="geometry"/></mxCell><mxCell id="f4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Load the entity profiles (Indian 24 columns, International 15), customer rules and keyword list&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="300" height="100" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Sheet API&lt;/b&gt;&lt;br&gt;profiles, customer rules, keyword list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="373" width="200" height="74" as="geometry"/></mxCell><mxCell id="a4" value="Claim the next pending PDF / JPEG work item&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="498" width="300" height="84" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Go work-item API&lt;/b&gt;&lt;br&gt;work items (PostgreSQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="800" y="503" width="300" height="74" as="geometry"/></mxCell><mxCell id="a5" value="Password-protected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="618" width="260" height="104" as="geometry"/></mxCell><mxCell id="b5" value="Unlock with the password list; cannot open → exception, no call&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="628" width="300" height="84" as="geometry"/></mxCell><mxCell id="a6" value="Read the document: header, invoice lines, colour per field&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="758" width="300" height="84" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;Extraction API&lt;/b&gt;&lt;br&gt;extraction service (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="763" width="200" height="74" as="geometry"/></mxCell><mxCell id="a7" value="Busy or timed out?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="878" width="260" height="104" as="geometry"/></mxCell><mxCell id="b7" value="Hold the item and retry later (attempt count)&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go work-item API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="888" width="300" height="84" as="geometry"/></mxCell><mxCell id="a8" value="Apply the customer rules; match the customer name by keyword&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1018" width="300" height="84" as="geometry"/></mxCell><mxCell id="a9" value="Normalise dates, amounts, IDs; derive the net amount&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1148" width="300" height="84" as="geometry"/></mxCell><mxCell id="a10" value="Passes the checks?&lt;br&gt;required fields, no red field, lines = total" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="1260" width="300" height="120" as="geometry"/></mxCell><mxCell id="b10" value="Not written to the workbook: exception record (reason, raw reply, PDF path); copy to NeedValidation&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go file API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="1265" width="300" height="110" as="geometry"/></mxCell><mxCell id="a11" value="Keep the advice rows for the day workbook; file the PDF to ExtractedPDF&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1408" width="300" height="84" as="geometry"/></mxCell><mxCell id="r11" value="&lt;b&gt;Go file API&lt;/b&gt;&lt;br&gt;ExtractedPDF folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="1413" width="200" height="74" as="geometry"/></mxCell><mxCell id="a12" value="Record the item outcome: Done, Held or Exception&lt;br&gt;&lt;font color=&quot;#56517e&quot;&gt;&lt;i&gt;Go API&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="1543" width="300" height="74" as="geometry"/></mxCell><mxCell id="r12" value="&lt;b&gt;Go work-item API&lt;/b&gt;&lt;br&gt;complete / fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="90" y="1543" width="200" height="74" as="geometry"/></mxCell><mxCell id="a13" value="More pending items?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#