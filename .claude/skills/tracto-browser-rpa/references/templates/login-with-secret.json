{
  "id": "login-with-secret",
  "name": "Login With Secret",
  "version": "1.0.0",
  "params": {
    "portalUrl": "https://portal.example.com/login",
    "username": "robot@example.com"
  },
  "segments": [
    {
      "name": "Sign in and read the balance",
      "runtime": "browser",
      "steps": [
        {
          "stepNumber": 1,
          "action": "navigate",
          "description": "Open the portal",
          "parameters": {
            "url": "${param.portalUrl}"
          }
        },
        {
          "stepNumber": 2,
          "action": "wait",
          "description": "Wait for the form",
          "parameters": {
            "label": "Username",
            "timeoutMs": "20000"
          }
        },
        {
          "stepNumber": 3,
          "action": "fill",
          "description": "Type the username",
          "parameters": {
            "label": "Username",
            "value": "${param.username}"
          }
        },
        {
          "stepNumber": 4,
          "action": "fill",
          "description": "Type the password",
          "parameters": {
            "label": "Password",
            "value": "${secret:PORTAL_PASSWORD}"
          }
        },
        {
          "stepNumber": 5,
          "action": "click",
          "description": "Sign in",
          "parameters": {
            "role": "button",
            "name": "Sign in"
          }
        },
        {
          "stepNumber": 6,
          "action": "wait",
          "description": "Wait for the dashboard",
          "parameters": {
            "text": "Balance",
            "timeoutMs": "30000"
          }
        },
        {
          "stepNumber": 7,
          "action": "getText",
          "description": "Read the balance",
          "parameters": {
            "testId": "account-balance",
            "storeAs": "balance"
          }
        }
      ]
    }
  ]
}