{
  "id": "portal-login-child",
  "name": "Portal Login (one site)",
  "version": "1.0.0",
  "params": { "site": "site-a", "url": "http://localhost:8780/a.html" },
  "segments": [
    {
      "name": "Sign in to one portal with its stored credential",
      "runtime": "browser",
      "mode": "headless",
      "steps": [
        { "stepNumber": 1, "action": "navigate", "description": "Open the portal",
          "parameters": { "url": "${param.url}" } },
        { "stepNumber": 2, "action": "fill", "description": "Enter the user id of this site's credential",
          "parameters": { "label": "User ID", "value": "${credential:${param.site}.username}" } },
        { "stepNumber": 3, "action": "fill", "description": "Enter the password of this site's credential",
          "parameters": { "label": "Password", "value": "${credential:${param.site}.password}" } },
        { "stepNumber": 4, "action": "click", "description": "Sign in",
          "parameters": { "role": "button", "name": "Sign in" } },
        { "stepNumber": 5, "action": "assert", "description": "The portal accepted the sign-in",
          "parameters": { "kind": "textEquals", "css": "#status", "expected": "Signed in" } },
        { "stepNumber": 6, "action": "getText", "description": "Read the welcome line",
          "parameters": { "css": "#welcome", "storeAs": "welcome" } }
      ]
    }
  ]
}