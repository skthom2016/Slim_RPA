<UserControl x:Class="Tracto.Designer.App.Views.SigningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600">
    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="4">
        <StackPanel>

            <!-- Header row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Script Signing" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SignerName}" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,12,0"/>
                <Button Content="Sign"   Command="{Binding SignCommand}"   Margin="2,0" Padding="6,2"/>
                <Button Content="Verify" Command="{Binding VerifyCommand}" Margin="2,0" Padding="6,2"/>
            </StackPanel>

            <!-- Signature details (visible when signed) -->
            <StackPanel Margin="0,0,0,4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Signed" FontWeight="Bold" Foreground="Green" Margin="0,0,0,2"/>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Algorithm: {0}">
                            <Binding Path="CurrentSignature.Algorithm"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Timestamp: {0}">
                            <Binding Path="CurrentSignature.Timestamp"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Digest: {0}...">
                            <Binding Path="CurrentSignature.Digest" Converter="{StaticResource DigestTruncateConverter}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Verification result (visible when IsVerified is not null) -->
            <TextBlock Text="&#x2713; Signature Valid" Foreground="Green" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="&#x2717; Signature Invalid" Foreground="Red" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </Border>
</UserControl>
