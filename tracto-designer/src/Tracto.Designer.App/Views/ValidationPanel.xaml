<UserControl x:Class="Tracto.Designer.App.Views.ValidationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600">
    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="4">
        <StackPanel>

            <!-- Header row: title + status icon + validate button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Validation" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="&#x2713; Valid" Foreground="Green" FontSize="13" VerticalAlignment="Center"
                           Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="&#x2717; Invalid" Foreground="Red" FontSize="13" VerticalAlignment="Center"
                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Validate" Command="{Binding ValidateCommand}" Margin="12,0,0,0" Padding="6,2"/>
            </StackPanel>

            <!-- Error/warning list — only visible after at least one validation run -->
            <ItemsControl ItemsSource="{Binding Result.Errors}"
                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <!-- Severity badge -->
                            <Border Width="18" Height="18" CornerRadius="2" Margin="0,0,6,0"
                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}">
                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLetterConverter}}"
                                           Foreground="White" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- RuleId -->
                            <TextBlock Text="{Binding RuleId}" FontFamily="Consolas" Width="72"
                                       VerticalAlignment="Center" Foreground="Gray"/>
                            <!-- Message -->
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="4,0"/>
                            <!-- StepNumber (displayed when not null via StringFormat) -->
                            <TextBlock Text="{Binding StepNumber, StringFormat='(step \{0\})'}"
                                       VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
