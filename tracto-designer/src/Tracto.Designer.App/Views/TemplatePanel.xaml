<UserControl x:Class="Tracto.Designer.App.Views.TemplatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Tracto.Designer.Core.Templates;assembly=Tracto.Designer.Core">
    <DockPanel>
        <!-- Search + Category Filter -->
        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="4,0,0,0"
                      SelectedItem="{Binding CategoryFilter}">
                <ComboBox.ItemsSource>
                    <Binding Path="Categories"/>
                </ComboBox.ItemsSource>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Use Template Button -->
        <Button DockPanel.Dock="Bottom" Content="Use Template"
                Command="{Binding UseTemplateCommand}"
                Margin="4,2,4,4" Padding="8,4"/>

        <!-- Template List -->
        <ListView ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate}"
                  Margin="4,0,4,0">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type core:ScriptTemplate}">
                    <TextBlock Text="{Binding Name}">
                        <TextBlock.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Category}"/>
                            </StackPanel>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</UserControl>
