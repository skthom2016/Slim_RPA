<UserControl x:Class="Tracto.Designer.App.Views.PrivacyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="400">
    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="4">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Privacy Controls" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <!-- Redaction Policy -->
            <GroupBox Header="Redaction Policy" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                    <CheckBox Content="Redact Passwords"
                              IsChecked="{Binding RedactPasswords}"
                              IsEnabled="False"
                              Margin="0,2"/>
                    <CheckBox Content="Redact Email Addresses"
                              IsChecked="{Binding RedactEmail}"
                              Margin="0,2"/>
                    <CheckBox Content="Redact Phone Numbers"
                              IsChecked="{Binding RedactPhone}"
                              Margin="0,2"/>
                    <CheckBox Content="Redact SSNs"
                              IsChecked="{Binding RedactSsn}"
                              Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <!-- Capture Settings -->
            <GroupBox Header="Capture Settings" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                    <CheckBox Content="Allow Screenshots"
                              IsChecked="{Binding AllowScreenshots}"
                              Margin="0,2"/>
                    <CheckBox Content="Allow Narration Export"
                              IsChecked="{Binding AllowNarrationExport}"
                              Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <!-- Reset button -->
            <Button Content="Reset to Defaults"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    Padding="10,4"/>

        </StackPanel>
    </Border>
</UserControl>
